rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Lumina Daily — Firestore 보안 규칙
    //
    // 데이터 모델
    //   /users/{userId}                     — 사용자 설정 + 추천(referral) 필드
    //   /users/{userId}/history/{quoteId}   — 배달된 명언 기록
    //   /test/connection                    — 연결 확인용(읽기 전용)
    //
    // 설계 원칙 (2026-05-30 재작성)
    //   - 본인 소유 문서만 접근(isOwner). 타인 데이터는 일절 불가.
    //   - 필드 단위 화이트리스트 검증은 두지 않는다. 과거 엄격한
    //     hasOnly/hasAll 검증이 클라이언트 스키마 변화(referralCode,
    //     fontSize, notificationTimeUTC, source/poolQuoteId 등)와 어긋나
    //     정상 쓰기를 거부했다. 사용자는 자기 문서만 쓸 수 있으므로
    //     필드 검증 제거는 보안 손실이 사실상 없다.
    //   - 단, role 자가 승격(admin)만은 차단한다(권한 상승 방지).
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // 생성: 본인 문서이고, role 을 admin 으로 셀프 부여하지 않을 것
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'client');

      // 수정: 본인 문서이고, role 을 바꾸지 않을 것(관리자만 변경 가능)
      allow update: if isOwner(userId) &&
        (!('role' in request.resource.data)
          || request.resource.data.role == resource.data.role
          || isAdmin());

      allow delete: if isOwner(userId) || isAdmin();

      // 명언 기록 — 본인만 읽고 쓴다. 필드 검증 없음(자기 데이터).
      match /history/{quoteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // 향후 추가될 하위 컬렉션도 본인만 접근
      match /{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 연결 확인용 — 인증된 사용자면 읽기 허용(App.tsx 의 test/connection)
    match /test/{docId} {
      allow read: if isAuthenticated();
    }
  }
}
